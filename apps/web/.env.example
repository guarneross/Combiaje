# ---------------------------------------------------------------------------
# Combiaje · apps/web
# Copia este archivo a .env.local y ajusta lo que necesites.
# Todo lo que empieza con NEXT_PUBLIC_ viaja al navegador: nunca pongas
# secretos aquí.
# ---------------------------------------------------------------------------

# Base de la API. El cliente le agrega /api/v1.
# En local, con mocks encendidos, el valor no importa pero debe existir.
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL pública del sitio. Se usa para metadata, Open Graph y el manifest.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Interceptar la red con MSW y responder con rutas simuladas de Puebla.
# Déjalo en true mientras el backend no exista. Nunca en producción.
NEXT_PUBLIC_ENABLE_MOCKS=true

# Estilo base del mapa.
# Respaldo temporal de CARTO mientras no exista el .pmtiles de Puebla.
# Cuando exista, apunta al archivo: pmtiles://https://.../puebla.pmtiles
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
NEXT_PUBLIC_MAP_STYLE_URL_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Teselas de las rutas: archivo .pmtiles generado con tippecanoe.
# Déjalo vacío mientras no exista el dataset — el mapa usa entonces el GeoJSON
# de las rutas simuladas de MSW. Cuando exista:
#   pmtiles://https://combiaje.joscian.com/tiles/rutas.pmtiles
NEXT_PUBLIC_ROUTES_PMTILES_URL=
