# ---------------------------------------------------------------------------
# Combiaje · apps/web
# Copia este archivo a .env.local y ajusta lo que necesites.
# Todo lo que empieza con NEXT_PUBLIC_ viaja al navegador: nunca pongas
# secretos aquí.
# ---------------------------------------------------------------------------

# Base de la API. El cliente le agrega /api/v1.
# En local, con mocks encendidos, el valor no importa pero debe existir.
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL pública del sitio. Se usa para metadata, Open Graph y el manifest.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Interceptar la red con MSW y responder sin servidor.
#
# `true` en desarrollo, **`false` en producción** desde el bloque 7: la API ya
# existe de verdad, en app/api/v1/. Si se queda en true, MSW se pone delante y
# el sitio sirve datos simulados aunque haya base de datos detrás.
NEXT_PUBLIC_ENABLE_MOCKS=true

# Estilo base del mapa.
# Respaldo temporal de CARTO mientras no exista el .pmtiles de Puebla.
# Cuando exista, apunta al archivo: pmtiles://https://.../puebla.pmtiles
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
NEXT_PUBLIC_MAP_STYLE_URL_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Teselas de las rutas: archivo .pmtiles generado con tippecanoe.
# Déjalo vacío mientras no exista el dataset — el mapa usa entonces el GeoJSON
# de las rutas simuladas de MSW. Cuando exista:
#   pmtiles://https://combiaje.joscian.com/tiles/rutas.pmtiles
NEXT_PUBLIC_ROUTES_PMTILES_URL=

# ---------------------------------------------------------------------------
# Supabase · solo las calificaciones de la comunidad
#
# Las rutas NO viven aquí: vienen de data/rutas/ y del JSON generado. Sin estas
# dos variables la aplicación funciona completa salvo las calificaciones, y eso
# es a propósito — se puede desarrollar sin depender de un servicio.
#
# Las dos son públicas: la URL del proyecto y la llave anónima, que es la misma
# que viaja al navegador. NO existe ni debe existir aquí la contraseña de la
# base ni la llave de servicio: quien decide qué fila toca cada quien es la
# seguridad a nivel de fila de Postgres. Ver src/server/supabase.ts.
#
# Panel de Supabase → Project Settings → API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
